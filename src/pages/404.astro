---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="404 - 页面未找到 | anemoi-blog" description="你访问的页面不存在">
  <section class="min-h-[70vh] flex items-center justify-center px-6">
    <div class="text-center space-y-8 max-w-lg">
      <!-- 大号 404 数字 -->
      <h1 class="font-display text-[8rem] sm:text-[10rem] leading-none tracking-[0.1em] text-anemoi-accent/30 select-none">
        404
      </h1>

      <!-- 提示文字 -->
      <div class="space-y-3">
        <p class="font-display text-2xl sm:text-3xl tracking-[0.15em] text-anemoi-text">
          风把页面吹走了
        </p>
        <p class="text-anemoi-muted text-sm tracking-wider leading-relaxed">
          你访问的页面不存在，也许它从未存在过<br />
          也许它已经随风而去了
        </p>
      </div>

      <!-- 分割线装饰 -->
      <div class="flex items-center justify-center gap-3">
        <span class="block w-12 h-px bg-anemoi-accent/30"></span>
        <span class="block w-1.5 h-1.5 rounded-full bg-anemoi-accent/50"></span>
        <span class="block w-12 h-px bg-anemoi-accent/30"></span>
      </div>

      <!-- 返回按钮 -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={base + '/'}
          class="group inline-flex items-center gap-2 px-6 py-2.5 border border-anemoi-accent/40 rounded-full text-sm tracking-widest text-anemoi-text hover:bg-anemoi-accent/10 hover:border-anemoi-accent transition-all duration-300"
        >
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          回到首页
        </a>
        <a
          href={base + '/archive/'}
          class="group inline-flex items-center gap-2 px-6 py-2.5 border border-anemoi-accent/20 rounded-full text-sm tracking-widest text-anemoi-muted hover:text-anemoi-text hover:border-anemoi-accent/40 transition-all duration-300"
        >
          浏览归档
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
