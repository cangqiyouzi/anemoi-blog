---
import BaseLayout from "../layouts/BaseLayout.astro";
import FriendShowcase from "../components/FriendShowcase.astro";

/*
 * 友链数据修改说明：
 * 直接在下面的 friends 数组中添加、删除或修改对象即可。
 * 每个友链对象包含以下字段：
 *   - id: 唯一标识
 *   - name: 博客名称（大标题）
 *   - subName: 拼音/注音小字（可选）
 *   - avatar: 圆形头像图片路径
 *   - preview: 左侧大图/站点预览图路径
 *   - category: 分类标签（带下划线的小标题）
 *   - author: 博主名
 *   - slogan: 左侧竖排文字
 *   - description: 简介正文
 *   - url: 外链地址（为空时隐藏"访问站点"按钮）
 *
 * 图片可存放于 public/images/ 目录下，引用时使用绝对路径如 "/images/avatar-1.jpg"。
 * 也可使用外部图床链接（如 https://picsum.photos/seed/xxx/600/800）。
 */
const friends = [
  {
    id: "1",
    name: "OneV's Den",
    subName: "王巍的博客",
    avatar: "https://onevcat.com/assets/images/avatar.jpg",
    preview: "https://onevcat.com/assets/images/avatar.jpg",
    category: "Swift & iOS 开发者",
    author: "博主：王巍 (onevcat)",
    slogan: "上善若水，人淡如菊",
    description:
      "专注于 Swift 和 iOS 开发的技术博客。记录技术与思考，从 AI Agent 协作到版本控制，从性能优化到 vibe coding，见证着智能时代的开发变革。",
    url: "https://onevcat.com/",
  },
  {
    id: "2",
    name: "锦恢的产品杂谈",
    subName: "黄哲龙的博客",
    avatar:
      "https://kirigaya.cn/api/storage/image/avatar_32e16cb9-e5a4-4526-82fa-15ab7a7c06b9.jpg",
    preview:
      "https://kirigaya.cn/api/storage/image/avatar_32e16cb9-e5a4-4526-82fa-15ab7a7c06b9.jpg",
    category: "AI Agent 与产品思考",
    author: "博主：黄哲龙 / 锦恢",
    slogan: "以恢为锦，求索真理",
    description:
      "00 后软件工程师，即将加入阿里巴巴从事 AI 智能体相关工作。分享 AI Agent 教程、产品思考、创业经验。常用 TypeScript、Python 和 Go，热衷于让更多人享受 AI 技术的便利。",
    url: "https://kirigaya.cn/",
  },
  {
    id: "3",
    name: "LVY NEKO",
    subName: "lvy 的小站",
    avatar: "https://lvyovo-wiki.tech/images/avatar.png",
    preview: "https://lvyovo-wiki.tech/images/avatar.png",
    category: "开源爱好者 & CS 学生",
    author: "博主：lvy",
    slogan: "尝试通过自动化手段实现任何可持续的行为",
    description:
      "2005 年出生的 recreational coder & open source enthusiast，目前 CS 本科在读。热爱 VS Code，乐于为有趣的项目和想法免费贡献代码。相信学习的目的是理解各种设计。",
    url: "https://lvyovo-wiki.tech/",
  },
  {
    id: "4",
    name: "Luminous' Home",
    subName: "夜光的个人小窝",
    avatar:
      "https://cdn.luotianyi.vc/wp-content/uploads/2020-02-13_09-22-57.jpg",
    preview:
      "https://cdn.luotianyi.vc/wp-content/uploads/2020-02-13_09-22-57.jpg",
    category: "网络技术与生活记录",
    author: "博主：Luminous (夜光)",
    slogan: "记录生活中的点滴，留下回忆与怀恋",
    description:
      "一条很咸的🐟，关注计算机、网络技术，却是地质专业。分享 frp 内网穿透、OpenWRT 配置、VPS 测评等技术内容。域名 luotianyi.vc 意为 LuoTianYi(VOCALOID CHINA)。",
    url: "https://luotianyi.vc/",
  },
];
---

<BaseLayout
  title="友链 - anemoi-blog"
  description="anemoi-blog 的友链展示"
  transparentNav={false}
>
  <FriendShowcase friends={friends} />
</BaseLayout>
