---
import { getCollection } from 'astro:content';
import ScrollReveal from './ScrollReveal.astro';

const posts = await getCollection('blog');

// 统计标签
const tagCounts: Record<string, number> = {};
posts.forEach((post) => {
  post.data.tags?.forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

const tags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({ name, count }));

const maxCount = Math.max(...tags.map((t) => t.count), 1);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{tags.length > 0 && (
  <section class="px-6 py-16 md:py-24 bg-anemoi-warm/30">
    <div class="max-w-4xl mx-auto text-center">
      <ScrollReveal>
        <h2 class="text-2xl md:text-3xl font-display mb-4 tracking-[0.15em] text-anemoi-deep">
          风之絮语
        </h2>
        <p class="text-anemoi-muted text-sm tracking-wider mb-12 font-light">
          按主题浏览文章
        </p>
      </ScrollReveal>
      
      <div class="flex flex-wrap justify-center gap-3 md:gap-4">
        {tags.map((tag, index) => {
          const size = 0.9 + (tag.count / maxCount) * 0.2;
          return (
            <ScrollReveal delay={index * 0.05}>
              <a
                href={base + `/tags/${tag.name}/`}
                class="inline-block px-4 py-2 bg-anemoi-ivory/80 hover:bg-anemoi-ivory text-anemoi-muted hover:text-anemoi-accent border border-anemoi-accent/10 hover:border-anemoi-accent/40 rounded-sm transition-all duration-300 tracking-wider"
                style={`font-size: ${size}rem;`}
              >
                {tag.name}
                <span class="text-xs text-anemoi-muted/50 ml-1">{tag.count}</span>
              </a>
            </ScrollReveal>
          );
        })}
      </div>
    </div>
  </section>
)}
