<button 
  id="back-to-top"
  class="fixed bottom-8 right-8 z-40 w-10 h-10 rounded-full border border-anemoi-accent/30 bg-anemoi-bg/80 backdrop-blur-sm flex items-center justify-center text-anemoi-muted hover:text-anemoi-text hover:border-anemoi-accent/60 transition-all duration-300 opacity-0 translate-y-4 pointer-events-none"
  aria-label="返回顶部"
>
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
  </svg>
</button>

<script>
  (function() {
    const btn = document.getElementById('back-to-top');
    if (!btn) return;
    
    const toggleVisibility = () => {
      if (window.scrollY > window.innerHeight * 0.5) {
        btn.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
        btn.classList.add('opacity-100', 'translate-y-0');
      } else {
        btn.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
        btn.classList.remove('opacity-100', 'translate-y-0');
      }
    };
    
    window.addEventListener('scroll', toggleVisibility, { passive: true });
    
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  })();
</script>
