---
export interface Props {
  transparent?: boolean;
}

const { transparent = true } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: '首页' },
  { href: '/archive/', label: '归档' },
  { href: '/friends/', label: '友链' },
  { href: '/about/', label: '关于' },
];
---

<nav 
  id="main-nav"
  data-transparent={transparent ? 'true' : 'false'}
  class={`fixed top-0 left-0 right-0 z-40 transition-all duration-500 ${transparent ? 'bg-transparent' : 'bg-anemoi-bg/90 backdrop-blur-md shadow-sm'}`}
  transition:persist
>
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logo -->
    <a 
      href="/" 
      class="text-xl font-display tracking-[0.2em] text-anemoi-text hover:text-anemoi-accent transition-colors duration-300"
    >
      anemoi
    </a>
    
    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-10 text-sm tracking-wider">
      {navLinks.map((link) => (
        <a 
          href={link.href}
          data-nav-link
          class={`nav-link relative py-1 transition-colors duration-300 ${
            currentPath === link.href 
              ? 'text-anemoi-deep' 
              : 'text-anemoi-muted hover:text-anemoi-text'
          }`}
        >
          {link.label}
          {currentPath === link.href && (
            <span class="nav-active-indicator absolute bottom-0 left-0 w-full h-px bg-anemoi-accent/60" />
          )}
        </a>
      ))}
      
      <!-- 白天/黑夜模式切换 -->
      <button 
        id="theme-toggle"
        class="text-anemoi-muted hover:text-anemoi-text transition-colors duration-300"
        title="切换白天/黑夜模式"
        aria-label="切换白天/黑夜模式"
      >
        <!-- 太阳图标（当前为 dark 模式时显示，点击切换到 light） -->
        <svg id="theme-icon-sun" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- 月亮图标（当前为 light 模式时显示，点击切换到 dark） -->
        <svg id="theme-icon-moon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
    </div>
    
    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden text-anemoi-text p-1"
      aria-label="打开菜单"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  
  <!-- Mobile Menu -->
  <div 
    id="mobile-menu"
    class="md:hidden overflow-hidden transition-all duration-500 max-h-0 opacity-0"
  >
    <div class="px-6 pb-6 pt-2 space-y-4 bg-anemoi-bg/95 backdrop-blur-md">
      {navLinks.map((link) => (
        <a 
          href={link.href}
          data-nav-link
          class={`nav-link block text-sm tracking-wider py-2 transition-colors duration-300 ${
            currentPath === link.href 
              ? 'text-anemoi-deep' 
              : 'text-anemoi-muted hover:text-anemoi-text'
          }`}
        >
          {link.label}
        </a>
      ))}
      <button 
        id="theme-toggle-mobile"
        class="flex items-center gap-2 text-sm text-anemoi-muted hover:text-anemoi-text transition-colors duration-300 py-2"
      >
        <svg id="theme-icon-mobile-sun" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg id="theme-icon-mobile-moon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <span id="theme-label-mobile">切换模式</span>
      </button>
    </div>
  </div>
</nav>

<script>
  (function() {
    // 导航栏滚动效果
    const nav = document.getElementById('main-nav');
    if (!nav) return;
    
    const isTransparent = nav.dataset.transparent !== 'false';
    
    const updateNav = () => {
      if (window.scrollY > 80) {
        nav.classList.add('bg-anemoi-bg/90', 'backdrop-blur-md', 'shadow-sm');
        nav.classList.remove('bg-transparent');
      } else if (isTransparent) {
        nav.classList.remove('bg-anemoi-bg/90', 'backdrop-blur-md', 'shadow-sm');
        nav.classList.add('bg-transparent');
      } else {
        nav.classList.add('bg-anemoi-bg/90', 'backdrop-blur-md', 'shadow-sm');
        nav.classList.remove('bg-transparent');
      }
    };
    
    // 避免 View Transitions 下重复注册
    if ((window as any).__anemoi_scroll_navbar) {
      window.removeEventListener('scroll', (window as any).__anemoi_scroll_navbar);
    }
    (window as any).__anemoi_scroll_navbar = updateNav;
    
    window.addEventListener('scroll', updateNav, { passive: true });
    updateNav();
    
    // 移动端菜单切换
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');
    let menuOpen = false;
    
    menuBtn?.addEventListener('click', () => {
      menuOpen = !menuOpen;
      if (menuOpen) {
        mobileMenu!.classList.remove('max-h-0', 'opacity-0');
        mobileMenu!.classList.add('max-h-64', 'opacity-100');
        iconOpen!.classList.add('hidden');
        iconClose!.classList.remove('hidden');
        menuBtn.setAttribute('aria-expanded', 'true');
        menuBtn.setAttribute('aria-label', '关闭菜单');
      } else {
        mobileMenu!.classList.add('max-h-0', 'opacity-0');
        mobileMenu!.classList.remove('max-h-64', 'opacity-100');
        iconOpen!.classList.remove('hidden');
        iconClose!.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
        menuBtn.setAttribute('aria-label', '打开菜单');
      }
    });
    
    // 主题切换
    const toggleTheme = () => {
      const html = document.documentElement;
      const isDark = html.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateThemeIcons(isDark);
    };
    
    const updateThemeIcons = (isDark: boolean) => {
      const sun = document.getElementById('theme-icon-sun');
      const moon = document.getElementById('theme-icon-moon');
      const mobileSun = document.getElementById('theme-icon-mobile-sun');
      const mobileMoon = document.getElementById('theme-icon-mobile-moon');
      const labelMobile = document.getElementById('theme-label-mobile');
      
      if (sun && moon) {
        sun.classList.toggle('hidden', !isDark);
        moon.classList.toggle('hidden', isDark);
      }
      if (mobileSun && mobileMoon) {
        mobileSun.classList.toggle('hidden', !isDark);
        mobileMoon.classList.toggle('hidden', isDark);
      }
      if (labelMobile) {
        labelMobile.textContent = isDark ? '切换为白天' : '切换为黑夜';
      }
    };
    
    // 桌面端开关
    const themeToggle = document.getElementById('theme-toggle');
    themeToggle?.addEventListener('click', toggleTheme);
    
    // 移动端开关
    const themeToggleMobile = document.getElementById('theme-toggle-mobile');
    themeToggleMobile?.addEventListener('click', toggleTheme);
    
    // 初始化图标状态
    const initIcons = () => {
      const isDark = document.documentElement.classList.contains('dark');
      updateThemeIcons(isDark);
    };
    initIcons();
    
    // View Transitions 页面切换后更新图标和高亮
    document.addEventListener('astro:page-load', () => {
      initIcons();
      resetMenu();
      updateActiveLink();
    });

    // 更新导航栏当前页面高亮
    function updateActiveLink() {
      if (!nav) return;
      const currentPath = window.location.pathname;
      const navLinks = nav.querySelectorAll('a[data-nav-link]');
      navLinks.forEach((link) => {
        const href = link.getAttribute('href');
        if (!href) return;
        const isActive = currentPath === href;
        // 更新文字颜色类
        link.classList.toggle('text-anemoi-deep', isActive);
        link.classList.toggle('text-anemoi-muted', !isActive);
        // 更新底部高亮条
        let indicator = link.querySelector('.nav-active-indicator');
        if (isActive && !indicator) {
          indicator = document.createElement('span');
          indicator.className = 'nav-active-indicator absolute bottom-0 left-0 w-full h-px bg-anemoi-accent/60';
          link.appendChild(indicator);
        } else if (!isActive && indicator) {
          indicator.remove();
        }
      });
    }
    updateActiveLink();

    // 重置移动端菜单状态
    function resetMenu() {
      menuOpen = false;
      if (mobileMenu) {
        mobileMenu.classList.add('max-h-0', 'opacity-0');
        mobileMenu.classList.remove('max-h-64', 'opacity-100');
      }
      if (iconOpen && iconClose) {
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      }
      menuBtn?.setAttribute('aria-expanded', 'false');
      menuBtn?.setAttribute('aria-label', '打开菜单');
    }
  })();
</script>
