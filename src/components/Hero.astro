---
export interface Props {
  title?: string;
  subtitle?: string;
  backgroundImage?: string;
}

const { 
  title = 'anemoi-blog', 
  subtitle = '风之所向，心之所往',
  backgroundImage = '/images/hero-bg.jpg' 
} = Astro.props;
---

<section class="relative w-full h-screen min-h-[600px] flex items-center justify-center overflow-hidden">
  <!-- 背景图 -->
  <div 
    class="absolute inset-0 bg-cover bg-center bg-no-repeat"
    style={`background-image: url('${backgroundImage}');`}
  >
    <!-- 柔和遮罩 -->
    <div class="absolute inset-0 bg-gradient-to-b from-white/20 via-transparent to-anemoi-bg/80"></div>
  </div>
  
  <!-- 内容 -->
  <div class="relative z-10 text-center px-6 animate-fade-in">
    <h1 class="text-5xl md:text-7xl lg:text-8xl text-white drop-shadow-lg mb-6 font-serif tracking-wider">
      {title}
    </h1>
    <p class="text-lg md:text-xl text-white/90 drop-shadow-md font-light tracking-[0.3em]">
      {subtitle}
    </p>
  </div>
  
  <!-- 向下滚动提示 -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-float">
    <svg 
      class="w-6 h-6 text-white/70" 
      fill="none" 
      stroke="currentColor" 
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>
