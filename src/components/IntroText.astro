---
export interface Props {
  lines?: string[];
  align?: 'center' | 'left' | 'right';
}

const { 
  lines = [
    '风，从很远的地方吹来',
    '带来了未知的故事',
    '和未曾说出口的问候',
  ],
  align = 'center'
} = Astro.props;

const alignClass = {
  center: 'text-center',
  left: 'text-left',
  right: 'text-right',
}[align];
---

<section class={`py-24 md:py-32 px-6 ${alignClass}`}>
  <div class="max-w-3xl mx-auto space-y-6">
    {lines.map((line, index) => (
      <p 
        class="text-lg md:text-xl lg:text-2xl font-light text-anemoi-text/80 leading-loose tracking-wide"
        style={`animation-delay: ${index * 0.2}s`}
      >
        {line}
      </p>
    ))}
  </div>
</section>
