---
export interface Props {
  delay?: number;
  class?: string;
  tag?: keyof HTMLElementTagNameMap;
}

const { delay = 0, class: className = '', tag: Tag = 'div' } = Astro.props;
---

<Tag 
  class={`reveal ${className}`}
  style={`transition-delay: ${delay}s;`}
>
  <slot />
</Tag>

<script>
  (function() {
    const KEY = '__anemoi_reveal_observer';

    // 单例 IntersectionObserver，所有 .reveal 元素共享同一个 observer
    function getOrCreateObserver(): IntersectionObserver {
      if ((window as any)[KEY]) return (window as any)[KEY];

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
      );

      (window as any)[KEY] = observer;
      return observer;
    }

    function observeAll() {
      const observer = getOrCreateObserver();
      document.querySelectorAll('.reveal:not(.is-visible)').forEach((el) => {
        observer.observe(el);
      });
    }

    // 首次观察
    observeAll();

    // 清理
    document.addEventListener('astro:before-swap', () => {
      if ((window as any)[KEY]) {
        (window as any)[KEY].disconnect();
        delete (window as any)[KEY];
      }
    });

    // 新页面加载后重新观察
    document.addEventListener('astro:page-load', observeAll);
  })();
</script>
